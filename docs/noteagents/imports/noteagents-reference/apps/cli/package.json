{
  "name": "noteagents-cli",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts' --max-warnings=0"
  },
  "dependencies": {
    "commander": "^11.0.0",
    "ora": "^8.0.0",
    "chalk": "^5.0.0",
    "@noteagents/types": "workspace:*"
  },
  "devDependencies": {
    "@types/commander": "^2.12.5",
    "@types/ora": "^3.2.0",
    "@types/chalk": "^2.2.0",
    "typescript": "^5.5.0",
    "tsx": "^4.19.0",
    "eslint": "^8.57.0"
  }
}