{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "840px",
      "wideSize": "1360px"
    },
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": true,
      "defaultPalette": false,
      "palette": [
        {
          "slug": "primary",
          "color": "#0B2345",
          "name": "Azul Marinho Patriota"
        },
        {
          "slug": "primary-dark",
          "color": "#07172E",
          "name": "Azul Marinho Noturno"
        },
        {
          "slug": "secondary",
          "color": "#0B5FFF",
          "name": "Azul Institucional"
        },
        {
          "slug": "accent",
          "color": "#FFCC29",
          "name": "Amarelo Brasil"
        },
        {
          "slug": "green",
          "color": "#16803C",
          "name": "Verde Brasil"
        },
        {
          "slug": "green-light",
          "color": "#22A447",
          "name": "Verde Claro"
        },
        {
          "slug": "danger",
          "color": "#B42318",
          "name": "Vermelho Alerta"
        },
        {
          "slug": "background",
          "color": "#F7F8FA",
          "name": "Fundo Claro"
        },
        {
          "slug": "surface",
          "color": "#F1F3F5",
          "name": "Cinza Superfície"
        },
        {
          "slug": "border",
          "color": "#D9DEE7",
          "name": "Borda Suave"
        },
        {
          "slug": "text",
          "color": "#17202A",
          "name": "Texto Principal"
        },
        {
          "slug": "text-muted",
          "color": "#5D6673",
          "name": "Texto Secundário"
        },
        {
          "slug": "white",
          "color": "#FFFFFF",
          "name": "Branco Puro"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "Georgia, 'Times New Roman', serif",
          "name": "Editorial Serif",
          "slug": "headline"
        },
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
          "name": "Sans Padrão",
          "slug": "sans"
        }
      ],
      "fontSizes": [
        { "name": "Pequeno", "size": "0.8125rem", "slug": "small" },
        { "name": "Normal", "size": "1rem", "slug": "medium" },
        { "name": "Grande", "size": "1.25rem", "slug": "large" },
        { "name": "Extra Grande", "size": "1.75rem", "slug": "x-large" },
        { "name": "Manchete", "size": "2.5rem", "slug": "2x-large" },
        { "name": "Manchete Principal", "size": "3.25rem", "slug": "hero" }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "%", "vh", "vw"],
      "spacingSizes": [
        { "name": "1", "size": "0.25rem", "slug": "20" },
        { "name": "2", "size": "0.5rem", "slug": "30" },
        { "name": "3", "size": "0.75rem", "slug": "40" },
        { "name": "4", "size": "1rem", "slug": "50" },
        { "name": "5", "size": "1.5rem", "slug": "60" },
        { "name": "6", "size": "2rem", "slug": "70" },
        { "name": "7", "size": "3rem", "slug": "80" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--text)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "lineHeight": "1.6"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--headline)",
          "fontWeight": "700",
          "lineHeight": "1.15"
        },
        "color": { "text": "var(--wp--preset--color--primary)" }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--headline)",
          "fontWeight": "700",
          "lineHeight": "1.2"
        },
        "color": { "text": "var(--wp--preset--color--primary)" }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--headline)",
          "fontWeight": "600",
          "lineHeight": "1.25"
        },
        "color": { "text": "var(--wp--preset--color--text)" }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--primary)" },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--secondary)" }
        }
      }
    }
  }
}
