generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum UserRole {
  READER
  JOURNALIST
  REVIEWER
  EDITOR
  CHIEF_EDITOR
  ADMIN
}
enum ArticleStatus {
  DRAFT
  PITCH
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}
enum EditorialRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum ReviewDecision {
  APPROVE
  REQUEST_CHANGES
  REJECT
}
enum SourceKind {
  OFFICIAL
  RSS
  API
  WEBSITE
  DOCUMENT
}
enum SourceStatus {
  ACTIVE
  PAUSED
  ERROR
}
enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  REFUNDED
}
enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELED
}
enum PaymentProvider {
  EFI
}
enum FactCheckVerdict {
  TRUE
  MOSTLY_TRUE
  MIXED
  MOSTLY_FALSE
  FALSE
  UNVERIFIABLE
  OUT_OF_CONTEXT
}
enum IngestionStatus {
  QUEUED
  PROCESSING
  REVIEWED
  REJECTED
  FAILED
}
model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String?
  displayName String
  role UserRole @default(READER)
  emailVerifiedAt DateTime?
  disabledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  articles Article[] @relation("ArticleAuthor")
  reviews ArticleReview[] @relation("ReviewActor")
  approvedArticles Article[] @relation("ArticleHumanApprover")
  subscriptions Subscription[]
  auditEvents AuditEvent[] @relation("AuditActor")
  sessions RefreshSession[]

  @@index([role, disabledAt])
  @@map("users")
}
model RefreshSession {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipHash String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_sessions")
}
model Category {
  id String @id @default(cuid())
  slug String @unique
  name String
  description String?
  articles Article[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}
model Article {
  id String @id @default(cuid())
  slug String @unique
  title String
  excerpt String?
  body String @db.Text
  heroImageUrl String?
  status ArticleStatus @default(DRAFT)
  isSubscriberOnly Boolean @default(false)
  publishedAt DateTime?
  scheduledAt DateTime?
  authorId String
  categoryId String?
  riskLevel EditorialRiskLevel @default(MEDIUM)
  riskAssessment Json?
  humanApprovedAt DateTime?
  humanApprovedById String?
  seoTitle String?
  seoDescription String?
  canonicalUrl String?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author User @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  humanApprover User? @relation("ArticleHumanApprover", fields: [humanApprovedById], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sources ArticleSource[]
  reviews ArticleReview[]
  factChecks FactCheck[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId, status, publishedAt(sort: Desc)])
  @@index([authorId, updatedAt(sort: Desc)])
  @@map("articles")
}
model ArticleReview {
  id String @id @default(cuid())
  articleId String
  reviewerId String
  decision ReviewDecision
  riskLevel EditorialRiskLevel?
  riskNotes String? @db.Text
  notes String? @db.Text
  isSelfApproval Boolean @default(false)
  createdAt DateTime @default(now())
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  reviewer User @relation("ReviewActor", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([articleId, createdAt])
  @@map("article_reviews")
}
model Source {
  id String @id @default(cuid())
  name String
  url String @unique
  kind SourceKind
  status SourceStatus @default(ACTIVE)
  trustTier Int @default(3)
  termsUrl String?
  pollingSeconds Int @default(900)
  lastFetchedAt DateTime?
  lastSuccessAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items IngestionItem[]
  articles ArticleSource[]

  @@index([status, lastFetchedAt])
  @@map("sources")
}
model IngestionItem {
  id String @id @default(cuid())
  sourceId String
  externalId String?
  canonicalUrl String
  title String?
  publishedAt DateTime?
  fetchedAt DateTime @default(now())
  contentHash String
  payload Json
  status IngestionStatus @default(QUEUED)
  errorMessage String?
  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, contentHash])
  @@index([status, fetchedAt])
  @@index([canonicalUrl])
  @@map("ingestion_items")
}
model ArticleSource {
  articleId String
  sourceId String
  note String?
  createdAt DateTime @default(now())
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  source Source @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@id([articleId, sourceId])
  @@map("article_sources")
}
model FactCheck {
  id String @id @default(cuid())
  articleId String?
  claim String @db.Text
  verdict FactCheckVerdict?
  methodology String? @db.Text
  reviewedBy String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  article Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  evidence FactCheckEvidence[]

  @@index([verdict, createdAt])
  @@map("fact_checks")
}
model FactCheckEvidence {
  id String @id @default(cuid())
  factCheckId String
  url String
  title String?
  excerpt String? @db.Text
  sourceDate DateTime?
  capturedAt DateTime @default(now())
  factCheck FactCheck @relation(fields: [factCheckId], references: [id], onDelete: Cascade)

  @@index([factCheckId, capturedAt])
  @@map("fact_check_evidence")
}
model SubscriptionPlan {
  id String @id @default(cuid())
  code String @unique
  name String
  description String?
  priceCents Int
  currency String @default("BRL")
  interval String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  subscriptions Subscription[]

  @@map("subscription_plans")
}
model Subscription {
  id String @id @default(cuid())
  userId String
  planId String
  status SubscriptionStatus @default(PENDING)
  provider PaymentProvider @default(EFI)
  providerCustomerId String?
  startedAt DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?
  canceledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([userId, status])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}
model Payment {
  id String @id @default(cuid())
  subscriptionId String
  provider PaymentProvider @default(EFI)
  providerChargeId String? @unique
  providerReference String @unique
  status PaymentStatus @default(CREATED)
  amountCents Int
  currency String @default("BRL")
  paymentMethod String?
  checkoutUrl String?
  paidAt DateTime?
  refundedAt DateTime?
  rawEvent Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  events PaymentEvent[]

  @@index([subscriptionId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("payments")
}
model PaymentEvent {
  id String @id @default(cuid())
  paymentId String
  providerEventId String? @unique
  eventType String
  payload Json
  processedAt DateTime?
  processingError String?
  receivedAt DateTime @default(now())
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, receivedAt])
  @@map("payment_events")
}

model PushSubscription {
  id String @id @default(cuid())
  token String @unique
  deviceType String
  userAgent String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastSeenAt DateTime @default(now())

  @@index([active, lastSeenAt])
  @@map("push_subscriptions")
}

model AuditEvent {
  id String @id @default(cuid())
  actorId String?
  action String
  entityType String
  entityId String
  requestId String?
  metadata Json?
  createdAt DateTime @default(now())
  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_events")
}
model NewsletterSubscriber {
  id String @id @default(cuid())
  email String @unique
  confirmedAt DateTime?
  unsubscribedAt DateTime?
  source String?
  createdAt DateTime @default(now())

  @@index([confirmedAt, unsubscribedAt])
  @@map("newsletter_subscribers")
}
