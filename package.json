{
  "name": "opatriota-brasil",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.6",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "api:dev": "tsx watch backend/src/index.ts",
    "api:start": "tsx backend/src/index.ts",
    "backend:check": "tsc --noEmit -p backend/tsconfig.json",
    "backend:setup": "bash scripts/setup-backend.sh",
    "admin:promote": "tsx scripts/promote-admin.ts",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "core:worker": "tsx nucleo-operacional/src/worker.ts",
    "core:check": "tsc --noEmit -p nucleo-operacional/tsconfig.json",
    "next:dev": "next dev --port 3001",
    "next:build": "next build",
    "next:start": "next start --port 3001",
    "next:check": "tsc --noEmit -p tsconfig.next.json"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "^6.19.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "firebase-admin": "14.5.0",
    "helmet": "^8.1.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^16.4.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
