# O Patriota — Environment Configuration
# Arquitetura: load-balancing entre bancos por responsabilidade

# ─── Base ───
VITE_API_BASE_URL=/api
PUBLIC_SITE_URL=https://opatriota.com.br

# ═══════════════════════════════════════════════════════════
# BANCO 1 — CONTEÚDO & CACHE (Turso / libSQL)
# ═══════════════════════════════════════════════════════════
DATABASE_PROVIDER=turso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Fallback Firestore (legado):
# DATABASE_PROVIDER=firestore

# ═══════════════════════════════════════════════════════════
# BANCO 2 — PAGAMENTOS & TRANSAÇÕES (Neon Postgres)
# ═══════════════════════════════════════════════════════════
PAYMENTS_DATABASE_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# ═══════════════════════════════════════════════════════════
# BANCO 3 — BACKUP (Prisma Postgres)
# ═══════════════════════════════════════════════════════════
BACKUP_DATABASE_URL=

# ═══════════════════════════════════════════════════════════
# BANCO 4 — MONGODB (dados semiestruturados, agentes)
# ═══════════════════════════════════════════════════════════
MONGODB_URI=

# ═══════════════════════════════════════════════════════════
# STORAGE — IMAGENS (Vercel Blob)
# ═══════════════════════════════════════════════════════════
BLOB_READ_WRITE_TOKEN=

# ═══════════════════════════════════════════════════════════
# FIREBASE — Auth, Firestore, Push, Analytics
# ═══════════════════════════════════════════════════════════
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ═══════════════════════════════════════════════════════════
# PAGAMENTOS — EFÍ BANK (gateway principal)
# ═══════════════════════════════════════════════════════════
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_PIX_KEY=
EFI_SANDBOX=true
EFI_WEBHOOK_SECRET=

# Fallback: Mercado Pago (legado)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ═══════════════════════════════════════════════════════════
# IA — NVIDIA API
# ═══════════════════════════════════════════════════════════
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=google/gemma-4-31b-it
NVIDIA_MODEL_3=google/diffusiongemma-26b-a4b-it

# ═══════════════════════════════════════════════════════════
# IA — Gemini (Google)
# ═══════════════════════════════════════════════════════════
GEMINI_API_KEY=

# ═══════════════════════════════════════════════════════════
# MEMÓRIA DE AGENTES — MEM0
# ═══════════════════════════════════════════════════════════
MEM0_API_KEY=
MEM0_BASE_URL=https://api.mem0.ai
MEM0_ORG_ID=
MEM0_PROJECT_ID=

# ═══════════════════════════════════════════════════════════
# MARKETING — Facebook / Meta
# ═══════════════════════════════════════════════════════════
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PAGE_ID=

# ═══════════════════════════════════════════════════════════
# REGRAS DE SEGURANÇA
# ═══════════════════════════════════════════════════════════
# NUNCA prefixe segredos com VITE_ — valores VITE_* vão ao browser.
# Sanitize HTML antes de dangerouslySetInnerHTML (src/utils/sanitizeHtml.ts).
# Valide autorização no servidor, nunca apenas no cliente.
