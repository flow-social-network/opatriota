# Frontend / Firebase Authentication (configure in the hosting provider)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=o-patriota-5db52
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Emails authorized to open the admin UI, comma-separated (UI gate only; backend RBAC is still required)
VITE_ADMIN_EMAILS=deevoholding@gmail.com

# Frontend / AI (optional)
GEMINI_API_KEY=

# Backend API
NODE_ENV=development
API_PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler:5432/DB?sslmode=require
# Optional direct connection for migrations; keep server-side only.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
CORS_ORIGINS=http://localhost:3000

# Firebase Admin SDK (backend only; use host identity/ADC when possible)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_CHECK_REVOKED=true

# Meta Graph API (backend only; do not use VITE_ prefix for secrets)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=
META_OAUTH_REDIRECT_URI=http://localhost:8080/api/social/oauth/meta/callback
META_TOKEN_ENCRYPTION_KEY=
PUBLIC_APP_URL=http://localhost:3000
TRUST_PROXY=false

# Do not put real credentials in this file or commit a real .env.
# Production secrets must be stored in AWS Secrets Manager.
