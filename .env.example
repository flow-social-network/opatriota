# O Patriota — Environment Configuration
# Backend API URL (real portal data; no mock fallback)\nVITE_API_BASE_URL=\n\n# Public Firebase Web SDK configuration (Vite exposes VITE_* values to the browser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-only secrets. NEVER prefix these variables with VITE_.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_WEB_API_KEY=
PUBLIC_SITE_URL=https://opatriota.com.br

# Optional Gemini API key for server-side generation
GEMINI_API_KEY=
