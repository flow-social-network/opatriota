# Frontend / Firebase Authentication (configure in the hosting provider)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Emails authorized to open the admin UI, comma-separated (UI gate only; backend RBAC is still required)
VITE_ADMIN_EMAILS=admin@seudominio.com

# Frontend / AI (optional)
GEMINI_API_KEY=

# Backend API
NODE_ENV=development
API_PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# Do not put real credentials in this file or commit a real .env.
# Production secrets must be stored in AWS Secrets Manager.
